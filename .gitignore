# Regenerable and/or binary -- not the source of truth for this system.
# Re-derive via research-discovery / research-librarian; don't hand-edit.
# output/<year-week>/ mixes PDFs (binary, regenerable) with .md text and
# carousel files (source of truth) in the same folder, so only the PDFs
# themselves are ignored -- not the whole directory.
/output/**/*.pdf
/archive/pdf/**
/logs/**
!/logs/.gitkeep

# Generated aggregate -- rebuilt from papers/metadata/*.json by build_index.py
/papers/papers.csv

# Python
__pycache__/
*.pyc
